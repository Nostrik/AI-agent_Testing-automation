# Скопируй этот файл в .env и заполни. Настоящие ключи пиши только в .env, этот файл попадает в git.

# --- Хранилище ---
# Ключ шифрования паролей и API-ключей подключений в базе. Без него секреты хранятся открыто.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# При переносе базы на другую машину переноси ключ вместе с ней.
MASTER_KEY=
# Путь к базе данных (относительно корня проекта)
DB_URL=sqlite:///data/tester.db

# --- Модели ---
# Ollama для локальных моделей. В Docker указывай адрес сервера, а не localhost.
OLLAMA_URL=http://localhost:11434
# OpenRouter для облачных моделей клиента и судьи
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# --- Уведомления в Telegram ---
# Токен бота от @BotFather и id чата, куда слать (узнать: написать боту, затем открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сейчас кодом тестера не используется
ADMIN_API_KEY=

# --- Вход ---
# Ключ подписи cookie «Запомнить меня». Необязательно: без него создастся сам в data/.auth_secret.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# --- Docker ---
# Адрес сервера в сети Tailscale (tailscale ip -4), на нём откроется порт 8501.
# Для tailscale serve (HTTPS) укажи 127.0.0.1.
TAILSCALE_IP=
